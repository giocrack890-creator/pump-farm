generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  address         String        @id
  createdAt       DateTime      @default(now())
  referredBy      String?
  referralCode    String        @unique
  xHandle         String?
  /// Public farmer name shown on leaderboards (not the wallet address).
  displayName     String?       @unique
  flaggedSybil    Boolean       @default(false)
  /// In-game Hype balance. Never accept client-submitted balances.
  hypeBalance     Decimal       @default(50) @db.Decimal(20, 6)
  harvestStreak   Int           @default(0)
  /// UTC calendar day (YYYY-MM-DD) of last successful harvest.
  lastHarvestDay  String?
  lastDailyHypeAt DateTime?
  hasCompletedTutorial Boolean  @default(false)
  /// Last successful farm snapshot / heartbeat for offline worker progress.
  lastSeenAt      DateTime?
  seasonPoints    SeasonPoint[]
  plots           Plot[]
  stakes          Stake[]
  hypeLedger      HypeLedger[]
  workers         Worker[]
}

/// Hired / helper workers for idle auto-harvest (wallet-scoped).
model Worker {
  id            String   @id @default(cuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [address])
  /// Species / helper type key (matches FarmerSpeciesId or pack helper id).
  type          String
  tier          Int      @default(1)
  deployed      Boolean  @default(false)
  hireTimestamp DateTime @default(now())
  lastAutoHarvestAt DateTime?
  createdAt     DateTime @default(now())

  @@index([walletId, deployed])
}

model Season {
  id           String        @id @default(cuid())
  number       Int           @unique
  startsAt     DateTime
  endsAt       DateTime
  /// Measured on-chain pot at close, minus nothing — the reserve is applied
  /// when the split is computed. 18 decimals so ETH is stored to the wei.
  poolAmount   Decimal?      @db.Decimal(36, 18)
  closedAt     DateTime?
  payoutTxLog  PayoutTx[]
  seasonPoints SeasonPoint[]
}

model SeasonPoint {
  id       String  @id @default(cuid())
  walletId String
  wallet   Wallet  @relation(fields: [walletId], references: [address])
  seasonId String
  season   Season  @relation(fields: [seasonId], references: [id])
  points   Decimal @default(0) @db.Decimal(36, 6)

  @@unique([walletId, seasonId])
  @@index([seasonId, points])
}

model Plot {
  id          String    @id @default(cuid())
  walletId    String
  wallet      Wallet    @relation(fields: [walletId], references: [address])
  /// Slot index within the farm (0 .. STARTER_PLOTS-1).
  index       Int       @default(0)
  /// null = empty; otherwise "Basic" | "Hybrid" | "Golden"
  seedTier    String?
  plantedAt   DateTime?
  maturesAt   DateTime?
  harvestedAt DateTime?
  /// Cached display status; eligibility is always recomputed from timestamps.
  status      String    @default("empty")

  @@unique([walletId, index])
  @@index([walletId])
}

model Stake {
  id       String   @id @default(cuid())
  walletId String
  wallet   Wallet   @relation(fields: [walletId], references: [address])
  amount   Decimal  @db.Decimal(36, 18)
  lockDays Int
  lockedAt DateTime @default(now())
  unlockAt DateTime
  /// Verified on chain before the row is written. Unique so a double submit
  /// racing itself cannot record the same transfer twice.
  txHash   String   @unique
  // TODO: replace with audited on-chain staking program before mainnet.

  @@index([walletId])
}

model PayoutTx {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  walletId  String
  amount    Decimal  @db.Decimal(36, 18)
  /// Null until a send is confirmed. Never a placeholder — an unpaid row is
  /// unpaid, and a fake hash here reads as money that already went out.
  txHash    String?
  /// pending | paid | void
  status    String   @default("pending")
  paidAt    DateTime?
  note      String?
  /// USD value of `amount` at the moment the season closed, for the record.
  amountUsd Decimal? @db.Decimal(20, 6)
  /// Idempotency key: `${seasonId}:${walletId}` — never double-pay.
  idemKey   String   @unique
  dryRun    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([seasonId])
  @@index([status])
}

model AuthNonce {
  id        String   @id @default(cuid())
  address   String
  nonce     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([address, used])
}

model HypeLedger {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [address])
  amount    Decimal  @db.Decimal(20, 6)
  reason    String
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

model TreasuryTx {
  id        String   @id @default(cuid())
  /// deposit | payout
  type      String
  amount    Decimal  @db.Decimal(36, 18)
  txHash    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GoldenHarvestEvent {
  id             String   @id @default(cuid())
  startedAt      DateTime @default(now())
  endsAt         DateTime
  priceChangePct Decimal  @db.Decimal(10, 6)
  active         Boolean  @default(true)

  @@index([active, endsAt])
}

/// Rolling price samples for Golden Harvest detection (10-minute window).
model PriceSample {
  id        String   @id @default(cuid())
  priceUsd  Decimal  @db.Decimal(24, 12)
  sampledAt DateTime @default(now())

  @@index([sampledAt])
}

/// Runtime configuration an operator can change without a redeploy.
/// The token address lives here rather than in NEXT_PUBLIC_* because Next
/// inlines those at build time — repointing the game would need a deploy.
model AppConfig {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Every admin action, kept so a change to money-adjacent config is traceable.
model AdminAudit {
  id        String   @id @default(cuid())
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Rolling record of the fee pot, so the season pool is a measured figure
/// rather than whatever the balance happened to be at the instant of close.
model FeeSnapshot {
  id           String   @id @default(cuid())
  token        String?
  creator      String?
  claimableWei String
  pendingWei   String
  treasuryWei  String
  ethUsd       Decimal  @db.Decimal(20, 6)
  potEth       Decimal  @db.Decimal(36, 18)
  potUsd       Decimal  @db.Decimal(20, 6)
  venue        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
