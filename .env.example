# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.pumpfarm.net
NEXT_PUBLIC_TOKEN_TICKER=HOOD

# The Pons launch whose fees are the pot.
# This is only the SEED value — once set in /admin, the database row wins and
# the token can be repointed without a redeploy.
NEXT_PUBLIC_TOKEN_MINT=

# Wallet that holds claimed fees and sends season payouts.
TREASURY_WALLET_ADDRESS=
# Wallet players transfer to when they stake. Staking is refused until it is set.
STAKE_ESCROW_WALLET=
# Override who Pons credits with fees. Leave empty to read it from the launch.
PONS_CREATOR_ADDRESS=

# ── Chain ─────────────────────────────────────────────────────────────────
# Server-side RPC. Use a keyed endpoint (Alchemy) — the public one is
# rate-limited and sits behind it as a fallback. Never expose this to the browser.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RH_NETWORK=mainnet

# ── Wallets / auth ────────────────────────────────────────────────────────
# Reown AppKit (EVM / Robinhood Chain + SIWX). Required for Connect Wallet.
# Create a project at https://dashboard.reown.com — product AppKit, framework Next.js.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
AUTH_SECRET=generate-a-long-random-string
CRON_SECRET=generate-another-secret

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxszmyxnyfhhjvruepkp.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxszmyxnyfhhjvruepkp.supabase.co:5432/postgres

# ── Ops panel (/admin) ────────────────────────────────────────────────────
# Either is enough; both closed means the admin API is disabled, not open.
# ADMIN_TOKEN is the shared secret the payout script uses.
ADMIN_TOKEN=
# ADMIN_WALLETS lets an operator open /admin with the wallet they signed in with.
ADMIN_WALLETS=0x…,0x…

# ── Payouts ───────────────────────────────────────────────────────────────
# Master switch. Off means every season close stays a preview, no matter what
# the cron is asked to do. Also settable from /admin.
PAYOUTS_ENABLED=false
OPS_RESERVE_PCT=0.05
SILO_TARGET_ETH=100
GOLDEN_HARVEST_PRICE_THRESHOLD=0.15
MIN_PAYOUT_FARM_BALANCE=0
# Sending key. Export it for a single `npm run payout` run, then unset it.
# Never set this on the server — no request handler ever signs anything.
# PAYOUT_PRIVATE_KEY=
# Per-transfer ceiling for the payout script.
PAYOUT_MAX_ETH=1
# Where `npm run payout` reads the owed list from.
PUMPFARM_SERVER_URL=https://www.pumpfarm.net

# ── Local development ─────────────────────────────────────────────────────
# Both MUST be false in production: they let anyone play as the demo wallet,
# which pollutes the leaderboard the payouts are computed from.
DEMO_MODE=false
ALLOW_DEV_BYPASS=false
NEXT_PUBLIC_DEMO_PLAY=false
