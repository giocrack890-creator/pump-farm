# App
NEXT_PUBLIC_APP_URL=https://www.pumpfarm.net
NEXT_PUBLIC_TOKEN_MINT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_TICKER=FARM
