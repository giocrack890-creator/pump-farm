# Create a project at https://dashboard.reown.com — product AppKit, framework Next.js.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=https://xxszmyxnyfhhjvruepkp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxszmyxnyfhhjvruepkp.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxszmyxnyfhhjvruepkp.supabase.co:5432/postgres
RPC_URL=https://rpc.mainnet.chain.robinhood.com
TREASURY_WALLET_ADDRESS=
STAKE_ESCROW_WALLET=
# Dexscreener live feed (optional). Until $FARM launches, point at a liquid proxy pair.
# Example: MEME on Robinhood Chain for plumbing tests.
DEXSCREENER_CHAIN=robinhood
DEXSCREENER_PAIR_ID=0x4b7c86491df95f366b31217b2950d2c5136a2f19b6879613eac73d0e69092a1a
DEXSCREENER_TOKEN_ADDRESS=0x385F4f8ae47651ce5F58F5265395a669f8281e18
# Marks landing copy as "Live · $MEME proxy" (not $FARM).
NEXT_PUBLIC_PRICE_PROXY=true
AUTH_SECRET=generate-a-long-random-string
CRON_SECRET=generate-another-secret
# Public demo farm (no wallet) — set true on Vercel preview/prod to let anyone play
DEMO_MODE=true
ALLOW_DEV_BYPASS=true
NEXT_PUBLIC_DEMO_PLAY=true
OPS_RESERVE_PCT=0.05
GOLDEN_HARVEST_PRICE_THRESHOLD=0.15
MIN_PAYOUT_FARM_BALANCE=0
MOCK_TREASURY_ETH=12.45
